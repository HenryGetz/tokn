#!/usr/bin/env python3
"""
tokn — print GPT token counts for files/directories or stdin.

Usage examples:
  tokn                 # count tokens in current directory (default extensions)
  tokn file.md dir/    # specific paths
  echo "text" | tokn   # stdin stays supported
  tokn --per-file      # show per-file counts plus total

Dependencies: pip install tiktoken
"""

import argparse
import json
import os
import sys
from typing import Iterable, List, Set

try:
    import tiktoken
except ImportError:  # pragma: no cover - handled at runtime for users
    print("tiktoken is required. Install with: pip install tiktoken", file=sys.stderr)
    sys.exit(2)

DEFAULT_EXTS: Set[str] = {".md", ".markdown", ".txt"}


def resolve_encoding(model: str):
    try:
        return tiktoken.encoding_for_model(model)
    except KeyError:
        return tiktoken.get_encoding("o200k_base")


def should_include(path: str, all_files: bool, exts: Set[str]) -> bool:
    if all_files:
        return True
    _, ext = os.path.splitext(path)
    return ext.lower() in exts


def iter_files(paths: Iterable[str], all_files: bool, exts: Set[str], *, skip_hidden: bool = True) -> Iterable[str]:
    for p in paths:
        if not os.path.exists(p):
            continue
        if os.path.isfile(p):
            if should_include(p, all_files, exts):
                yield p
        elif os.path.isdir(p):
            for root, _, files in os.walk(p):
                # skip hidden directories unless requested
                parts = os.path.normpath(root).split(os.sep)
                if skip_hidden and any(part.startswith(".") and part != "." for part in parts):
                    continue
                for name in files:
                    fp = os.path.join(root, name)
                    # skip hidden files unless requested
                    if skip_hidden and any(part.startswith(".") and part != "." for part in os.path.normpath(fp).split(os.sep)):
                        continue
                    if should_include(fp, all_files, exts):
                        yield fp


def count_tokens_text(text: str, enc) -> int:
    return len(enc.encode(text))


def count_tokens_file(path: str, enc) -> int:
    try:
        with open(path, "r", encoding="utf-8", errors="ignore") as f:
            text = f.read()
        return count_tokens_text(text, enc)
    except Exception:
        return 0


def parse_exts(ext_list: List[str]) -> Set[str]:
    parsed: Set[str] = set()
    for raw in ext_list:
        val = raw if raw.startswith(".") else f".{raw}"
        parsed.add(val.lower())
    return parsed


def main():
    ap = argparse.ArgumentParser(
        add_help=True,
        description="Print GPT token counts across paths or stdin. Defaults to current directory when no paths are given and stdin is a TTY.",
    )
    ap.add_argument(
        "paths",
        nargs="*",
        help="Files and/or directories. If empty, reads current directory (TTY) or stdin (when piped)",
    )
    ap.add_argument("--all", action="store_true", help="Include all file types (not just md/txt)")
    ap.add_argument("--ext", "-e", action="append", default=[], help="Additional extension(s) to include, e.g. -e py -e .js")
    ap.add_argument("--model", default="gpt-5o", help="Model name to resolve encoding (default: gpt-5o)")
    ap.add_argument("--per-file", action="store_true", help="Print per-file counts before the total")
    ap.add_argument("--json", action="store_true", help="Output JSON (per-file and total)")
    ap.add_argument("--include-hidden", action="store_true", help="Include hidden files and directories")

    args = ap.parse_args()

    enc = resolve_encoding(args.model)
    exts = DEFAULT_EXTS | parse_exts(args.ext)

    # Determine input source
    paths = args.paths
    stdin_is_pipe = not sys.stdin.isatty()
    if not paths:
        if stdin_is_pipe:
            text = sys.stdin.read()
            total = count_tokens_text(text, enc)
            print(json.dumps({"total": total}) if args.json else f"{total:,}")
            return
        # default to current working directory
        paths = ["."]

    totals = []
    total_sum = 0
    for fp in iter_files(paths, args.all, exts, skip_hidden=not args.include_hidden):
        count = count_tokens_file(fp, enc)
        totals.append((fp, count))
        total_sum += count

    if args.json:
        payload = {
            "files": [{"path": p, "tokens": c} for p, c in totals],
            "total": total_sum,
        }
        print(json.dumps(payload, indent=2))
        return

    if args.per_file:
        for p, c in totals:
            print(f"{c:>10,}  {p}")

    print(f"{total_sum:,}")


if __name__ == "__main__":
    main()
